# Copy to .env and `set -a; source .env; set +a` (or use `dotenvx`/direnv)
# before `cargo run -p hello-backend` (or `webhello-backend`, which now
# shares hello's own Postgres table/S3 bucket -- see
# apps/webhello/backend's module doc). Matches docker-compose.yml's
# postgres/minio services exactly -- see docs/local-development.md.

DATABASE_URL=postgres://hello:hello@localhost:5432/hello

BUCKET_HOST=localhost
BUCKET_PORT=9000
BUCKET_NAME=hello
AWS_ACCESS_KEY_ID=devaccesskey
AWS_SECRET_ACCESS_KEY=devsecretkey

# For `cargo run -p idp-backend` (uses its own Postgres, a separate
# docker-compose service on a different port so it can run alongside
# hello-backend): DATABASE_URL=postgres://idp:idp@localhost:5433/idp
# BASE_URL=http://localhost:4000 (default if unset)

# For `cargo run -p hello-backend`/`portal-backend`/`webhello-backend`
# against a local idp-backend: IDP_ISSUER_URL=http://localhost:4000,
# AUTH_CLIENT_ID=hello (or "portal"/"webhello") -- both default sensibly
# if unset, see auth-adapter's `AuthState::from_env`.

# For `cargo run -p game-mgr-backend`: no dedicated Postgres compose service
# of its own -- create a database on the shared `postgres` service above
# (`createdb -h localhost -U hello game_mgr`) and point DATABASE_URL at it:
# DATABASE_URL=postgres://hello:hello@localhost:5432/game_mgr
# AUTH_CLIENT_ID=game-mgr (against a local idp-backend, same as above)
# It does have its own bucket though (`game-mgr`, created by minio-init
# above) -- override BUCKET_NAME to point at it instead of hello's:
# BUCKET_NAME=game-mgr
